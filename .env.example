# ---- Enterprise Decision Intelligence Platform configuration ----
# Copy to .env (backend reads it via pydantic-settings). All values optional.

# Application
EDIP_ENVIRONMENT=development
EDIP_DEBUG=true
EDIP_DATA_DIR=data
EDIP_MAX_UPLOAD_MB=200

# Database (SQLite by default; Postgres in docker-compose)
EDIP_DATABASE_URL=sqlite:///data/edip.db

# Vector store: memory (default, zero-setup) or pgvector
EDIP_VECTOR_BACKEND=memory
EDIP_PGVECTOR_URL=

# Embeddings: "hash" (built-in, no downloads) or a sentence-transformers model
EDIP_EMBEDDING_MODEL=hash
EDIP_EMBEDDING_DIM=256

# Queue (optional; BackgroundTasks used when false)
EDIP_USE_CELERY=false
EDIP_REDIS_URL=redis://localhost:6379/0

# LLM layer — provider-agnostic AI reasoning. All executive narrative
# (summaries, insights, root causes, risks, recommendations) is generated by
# this model from the compact business-context JSON. Swap providers by config
# only; the application never knows which provider is running.
#   none | ollama | openai | azure-openai | anthropic | gemini | enterprise
EDIP_LLM_PROVIDER=ollama
# Ollama: any installed model (qwen3, llama3, gemma3, mistral, deepseek, ...).
# Leave empty to auto-select the first installed model.
EDIP_LLM_MODEL=
EDIP_LLM_API_KEY=
# ollama default: http://localhost:11434 · enterprise: your OpenAI-compatible gateway
EDIP_LLM_BASE_URL=
EDIP_LLM_TIMEOUT_S=180
EDIP_LLM_RETRIES=2
# provider-specific extras, e.g. Azure: {"api_version": "2024-06-01"}
# or enterprise gateways with custom auth: {"auth_header": "X-Api-Key"}
EDIP_LLM_EXTRA={}

# Autonomous execution layer — the heartbeat. With this on, the platform
# observes, learns, plans, executes, monitors, and improves by itself; the
# manager reviews, approves, and decides strategy. Set false to stop the
# ticking: every engine still works on demand and every API still answers.
EDIP_AUTONOMY_ENABLED=true
EDIP_AUTONOMY_TICK_SECONDS=30
EDIP_AUTONOMY_QUEUE_INTERVAL_SECONDS=60
EDIP_AUTONOMY_REFRESH_INTERVAL_SECONDS=900
EDIP_AUTONOMY_PLANNING_INTERVAL_SECONDS=300
# 5-field cron (minute hour day-of-month month day-of-week), UTC
EDIP_AUTONOMY_DAILY_CYCLE_CRON=0 6 * * *
EDIP_AUTONOMY_MONITORING_CRON=0 * * * *
# Below this confidence the Decision Engine routes to a human whatever the
# action is — autonomy is bounded by evidence, never by optimism.
EDIP_AUTONOMY_CONFIDENCE_THRESHOLD=0.7
# Action kinds that always need human approval. Anything with an external
# effect belongs here; internal, reversible work does not.
EDIP_AUTONOMY_REQUIRES_APPROVAL=["send_email","create_meeting","send_message","update_business_rule","execute_automation"]

# Enterprise Knowledge Synchronization — once systems are connected,
# organizational knowledge updates continuously. Off = the registry, model,
# and search still answer; only the automatic refresh stops.
EDIP_SYNC_ENABLED=true
EDIP_SYNC_REFRESH_INTERVAL_SECONDS=900
EDIP_SYNC_HEALTH_INTERVAL_SECONDS=300
EDIP_SYNC_SWEEP_CRON=30 3 * * *
# Connected sources authenticate by REFERENCE: register a source with
# auth {"kind":"env","ref":"EDIP_SOURCE_WAREHOUSE_URL"} and put the secret in
# that variable. The platform never stores credentials.
# EDIP_SOURCE_WAREHOUSE_URL=postgresql://user:pass@host/db

# Product Intelligence & Strategic Decision Layer — the Enterprise Product
# Manager. Off = every product surface still answers on demand; only the
# automatic recalculation stops.
EDIP_PRODUCT_ENABLED=true
EDIP_PRODUCT_HEALTH_INTERVAL_SECONDS=900
EDIP_PRODUCT_REFRESH_INTERVAL_SECONDS=1800
EDIP_PRODUCT_KPI_INTERVAL_SECONDS=900
EDIP_PRODUCT_BRIEF_CRON=0 7 * * 1

# Enterprise Connector Framework (V2.1) — administrators configure a data
# source once; the Runtime synchronizes it from then on and every change
# becomes organizational knowledge. Off = the catalogue and manual sync still
# work; only the automatic synchronization stops.
EDIP_CONNECTORS_ENABLED=true
EDIP_CONNECTOR_SYNC_INTERVAL_SECONDS=900
EDIP_CONNECTOR_HEALTH_INTERVAL_SECONDS=300
EDIP_CONNECTOR_SWEEP_CRON=15 2 * * *

# Enterprise AI Operating Layer (V2.2) — the operational layers around the
# Brain. Evaluation runs a panel over AI output; governance enforces RBAC,
# approval, and retention policy. Both off = the platform behaves exactly as
# V2.1 (the V1 evidence guards remain in place regardless).
EDIP_EVALUATION_ENABLED=true
EDIP_GOVERNANCE_ENABLED=true
# What an unidentified caller is treated as. Preserves V2.1 behaviour by
# default; a governed deployment narrows this and assigns principals.
EDIP_GOVERNANCE_DEFAULT_ROLE=administrator
EDIP_OBSERVABILITY_LATENCY_ENABLED=true

# V2.2 generic outbound channels (adapter-based; used only when configured).
# EDIP_REST_BASE_URL=https://api.internal.example.com
# EDIP_REST_AUTH_TOKEN=...
# EDIP_WEBHOOK_URL=https://hooks.internal.example.com/edip

# Inference thresholds (tune, don't hardcode)
EDIP_PK_UNIQUENESS_THRESHOLD=0.99
EDIP_FK_OVERLAP_THRESHOLD=0.60
EDIP_FUZZY_MATCH_THRESHOLD=0.82
EDIP_DUPLICATE_SCHEMA_SIMILARITY=0.90
EDIP_OUTLIER_ZSCORE=3.0
